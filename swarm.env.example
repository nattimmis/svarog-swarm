# Copy to swarm.env and fill in. NEVER commit your real swarm.env.
# This file ships no real values on purpose.

# Comma-separated seed peers this node starts from (host:port). It learns the
# rest through gossip. Use names/addresses on your own private overlay.
SWARM_PEERS=peer-one.local:8080,peer-two.local:8080

# Local model id/path served by your runtime (ollama id, or a .gguf path).
SWARM_MODEL=your-local-model

# Where this node's own server binds.
SWARM_BIND=0.0.0.0:8080

# Optional stable id for this node (defaults to hostname-pid).
# SWARM_NODE_ID=node-a
